        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'ok', message: 'Disparo por grupo finalizado', campanha_id: $(\"Buscar Campanha\").first().json.id } }}",
        "options": {}
      },
      "name": "Resposta Sucesso",
